# ---------- Required ----------
# Atlas Sandbox connection string (from the hackathon Atlas Sandbox project)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=keystone
# Random 32+ char string for signing session cookies:  openssl rand -base64 32
AUTH_SECRET=
# 96-byte local KMS master key for field-level encryption (dev only):  openssl rand -base64 96 | tr -d '\n'
ENCRYPTION_MASTER_KEY=
# Public URL of this app (use ngrok/cloudflared for Twilio + Stripe webhooks)
APP_BASE_URL=http://localhost:3000

# ---------- AI agent ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Contractor discovery ----------
GOOGLE_PLACES_API_KEY=
# same Google key works if YouTube Data API v3 is enabled on it
YOUTUBE_API_KEY=

# ---------- Twilio (SMS, WhatsApp, calls) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# SAFETY: while demoing, ALL contractor SMS/calls are redirected to this number
# (a teammate's phone) so the agent never texts real businesses. Leave set during the hackathon.
DEMO_CONTRACTOR_PHONE=

# ---------- ElevenLabs (agent's phone voice) ----------
ELEVENLABS_API_KEY=
# optional: any voice id from your ElevenLabs Voice Library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email ----------
RESEND_API_KEY=
EMAIL_FROM=Keystone <onboarding@resend.dev>
